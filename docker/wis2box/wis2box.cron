50 23 * * * su wis2box -c "wis2box data archive" > /proc/1/fd/1 2>/proc/1/fd/2
55 23 * * * su wis2box -c "wis2box data observation ingest" > /proc/1/fd/1 2>/proc/1/fd/2
0 * * * * su wis2box -c "echo 'wis2box.cron is alive'" > /proc/1/fd/1 2>/proc/1/fd/2

# Update the odwr data for Oregon every day
# This needs to be run as root since it needs to access a json on disk that is mounted into the container
0 0 * * * /usr/local/bin/wis2box oregon odwr update  > /proc/1/fd/1 2>/proc/1/fd/2
